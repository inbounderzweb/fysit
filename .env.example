# MongoDB Atlas connection string
MONGODB_URI=

# Random 32+ character secret used to sign admin session JWTs.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Cloudinary (server-only — never expose CLOUDINARY_API_SECRET to the client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL, used for canonical URLs, sitemap, and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
# Google Search Console HTML-tag verification code (content value only), optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Gmail API (server only; never prefix with NEXT_PUBLIC_). See docs/email.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
GMAIL_USER=

