# MongoDB Atlas connection string
MONGODB_URI=

# Random 32+ character secret used to sign admin session JWTs.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Cloudinary (server-only — never expose CLOUDINARY_API_SECRET to the client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL, used for canonical URLs, sitemap, and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
